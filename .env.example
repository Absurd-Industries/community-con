# One secret, and only for running the backend locally.
#
# Copy this to `.dev.vars` in the repo root (gitignored) before `npm run dev:api`.
# The voting side needs nothing at all - voters have no accounts and no keys.

# The shared organiser password. In production this is NOT a file: set it with
#   npx wrangler secret put ADMIN_PASSWORD
ADMIN_PASSWORD=local-test-password
