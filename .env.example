# The design preview needs none of this. `npm install && npm run dev` is enough -
# all data lives in localStorage. See README.
#
# These are for the backend team, once apps/api is wired up:

# --- apps/api/.dev.vars ---
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...
# ADMIN_EMAIL=you@example.com          # comma-separated; first synced user is admin anyway
# DEV_NO_AUTH=false

# --- apps/web/.env.local ---
# VITE_API_URL=http://localhost:8787   # empty = same origin
