{
  // One Worker serves the whole thing: the voting site and its API.
  //
  // Requests to /api/* run the Worker (apps/api). Everything else is served
  // from apps/web/dist as a static file, falling back to index.html so the
  // client-side routes (/vote, /results, /admin/*) resolve instead of 404ing.
  //
  // Sharing one origin means there is no CORS to configure and no second URL to
  // keep in sync - which is most of why the backend is as small as it is.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "community-con",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-07-20",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this, the SPA fallback would answer /api/* with index.html and
    // the Worker would never see an API request.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "community-con",
      "database_id": "622c0123-3808-4723-b554-8224de5360e7",
      "migrations_dir": "apps/api/migrations"
    }
  ],
  // A brake on ballot spam, not a lock. Keyed on IP address, which is NOT
  // stored anywhere - the binding hashes it internally and we never read it.
  //
  // The limit is deliberately loose. At a conference, hundreds of people share
  // one address behind the venue's wifi, so a tight limit would silently block
  // a room full of legitimate voters. 100 a minute stops a script hammering
  // thousands per second while leaving a crowded NAT far below the line.
  "ratelimits": [
    {
      "name": "BALLOT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
  // ADMIN_PASSWORD is a secret, not a var. Set it with:
  //   npx wrangler secret put ADMIN_PASSWORD
}
